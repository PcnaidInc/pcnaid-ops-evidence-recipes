{
  "version": "1",
  "id": "azure-storage-transport",
  "name": "Azure storage transport settings",
  "description": "Observe three selected properties of one storage account. No blob enumeration or account-wide compliance conclusion.",
  "source": {
    "kind": "azure-storage",
    "url": "https://management.azure.com/subscriptions/{subscription_id}/resourceGroups/{resource_group}/providers/Microsoft.Storage/storageAccounts/{account_name}?api-version=2023-05-01",
    "tokenEnv": "AZURE_ACCESS_TOKEN",
    "reference": "https://learn.microsoft.com/en-us/rest/api/storagerp/storage-accounts/get-properties",
    "pagination": "single"
  },
  "fields": [
    {
      "name": "httpsOnly",
      "path": "/properties/supportsHttpsTrafficOnly"
    },
    {
      "name": "minimumTlsVersion",
      "path": "/properties/minimumTlsVersion"
    },
    {
      "name": "allowBlobPublicAccess",
      "path": "/properties/allowBlobPublicAccess"
    }
  ],
  "checks": [
    {
      "id": "https-only",
      "field": "httpsOnly",
      "operator": "equals",
      "expected": true,
      "description": "Secure transfer is required in the supplied account properties."
    },
    {
      "id": "tls-version",
      "field": "minimumTlsVersion",
      "operator": "one_of",
      "expected": [
        "TLS1_2",
        "TLS1_3"
      ],
      "description": "The explicitly returned minimum TLS version is 1.2 or 1.3."
    },
    {
      "id": "public-access-disabled",
      "field": "allowBlobPublicAccess",
      "operator": "equals",
      "expected": false,
      "description": "The account property explicitly disables blob public access."
    }
  ]
}
